{
  "schema_version": "1.0",
  "project": "Project Graph",
  "database": ".project-graph/cache/graph.sqlite",
  "assertion_globs": [".project-graph/assertions/*.jsonl"],
  "require_edge_evidence": true,
  "node_types": [
    "Component",
    "File",
    "Symbol",
    "Interface",
    "DataStore",
    "Invariant",
    "Flow",
    "Decision",
    "Verification",
    "Automation",
    "Prompt",
    "Skill"
  ],
  "predicates": [
    "DEFINES",
    "CALLS",
    "READS",
    "WRITES",
    "DEPENDS_ON",
    "IMPLEMENTS",
    "GUARDED_BY",
    "DOCUMENTED_IN",
    "VERIFIED_BY",
    "GENERATES",
    "RESOLVES",
    "ENFORCES",
    "USES",
    "ORCHESTRATES",
    "PUBLISHES"
  ],
  "impact_predicates": [
    "CALLS",
    "READS",
    "WRITES",
    "DEPENDS_ON",
    "IMPLEMENTS",
    "GUARDED_BY",
    "VERIFIED_BY",
    "GENERATES",
    "RESOLVES",
    "ENFORCES",
    "USES",
    "ORCHESTRATES",
    "PUBLISHES"
  ],
  "blocked_paths": [
    ".git/**",
    "**/.git/**",
    "target/**",
    "**/target/**",
    ".secrets/**",
    "**/.secrets/**",
    "*secret*",
    "**/*secret*",
    "*credential*",
    "**/*credential*",
    "*.tfstate",
    "*.tfstate.*",
    "**/*.tfstate",
    "**/*.tfstate.*",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*"
  ]
}
