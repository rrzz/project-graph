{"kind":"node","id":"component:cli","type":"Component","name":"Command-line interface","description":"Routes every user operation through one binary."}
{"kind":"node","id":"component:validation","type":"Component","name":"Assertion validation","description":"Checks vocabulary, references, review states, evidence policy, paths, and selectors."}
{"kind":"node","id":"component:evidence","type":"Component","name":"Evidence engine","description":"Selects anchor-based source spans and audits accepted hashes."}
{"kind":"node","id":"component:sqlite","type":"Component","name":"SQLite index builder","description":"Builds the disposable relational traversal index."}
{"kind":"node","id":"component:query","type":"Component","name":"Graph query engine","description":"Resolves aliases, searches facts, traverses neighborhoods, and finds paths."}
{"kind":"node","id":"component:evaluation","type":"Component","name":"Gold-question evaluator","description":"Runs deterministic bounded retrieval checks."}
{"kind":"node","id":"component:export","type":"Component","name":"Mermaid exporter","description":"Serializes the graph or a selected neighborhood as Mermaid."}
{"kind":"node","id":"store:assertions","type":"DataStore","name":"Reviewed JSONL assertions","description":"Portable repository-owned source of graph truth."}
{"kind":"node","id":"store:evidence-lock","type":"DataStore","name":"Evidence lock","description":"Explicitly accepted source-span hashes."}
{"kind":"node","id":"store:sqlite","type":"DataStore","name":"Generated SQLite index","description":"Disposable query cache derived from assertions and current evidence."}
{"kind":"node","id":"store:gold","type":"DataStore","name":"Gold questions","description":"Executable graph-retrieval expectations."}
{"kind":"node","id":"flow:ingestion","type":"Flow","name":"Assertion ingestion","description":"Loads configured JSONL records and validates them before indexing."}
{"kind":"node","id":"flow:evidence-acceptance","type":"Flow","name":"Evidence acceptance","description":"Validates current spans, explicitly locks them, and then builds the index."}
{"kind":"node","id":"flow:query","type":"Flow","name":"Read-only graph query","description":"Opens the generated database read-only and performs alias-aware retrieval."}
{"kind":"node","id":"invariant:portable-source-truth","type":"Invariant","name":"Assertions are authoritative","description":"SQLite is generated; reviewed JSONL remains portable source truth."}
{"kind":"node","id":"invariant:anchor-evidence","type":"Invariant","name":"Evidence uses source anchors","description":"Line-number selectors are rejected and anchored spans survive harmless movement."}
{"kind":"node","id":"invariant:blocked-before-read","type":"Invariant","name":"Blocked paths are rejected before reading","description":"Evidence policy prevents protected source content from being opened."}
{"kind":"node","id":"invariant:root-containment","type":"Invariant","name":"Evidence remains inside project root","description":"Canonical paths prevent evidence traversal or symlink escape."}
{"kind":"node","id":"invariant:explicit-acceptance","type":"Invariant","name":"Locking is explicit acceptance","description":"Source changes remain stale until an intentional lock operation."}
{"kind":"node","id":"invariant:atomic-index","type":"Invariant","name":"Index replacement is atomic","description":"A failed build preserves the last good SQLite index."}
{"kind":"node","id":"invariant:readonly-query","type":"Invariant","name":"Queries cannot mutate SQLite","description":"Query connections use read-only flags and query-only mode."}
{"kind":"node","id":"symbol:load-records","type":"Symbol","name":"load_records","description":"Loads configured JSONL assertions with origin information."}
{"kind":"node","id":"symbol:validate-records","type":"Symbol","name":"validate_records","description":"Validates assertions and optionally inspects source evidence."}
{"kind":"node","id":"symbol:snapshot-evidence","type":"Symbol","name":"snapshot_evidence","description":"Resolves an evidence selector and hashes its file and selected span."}
{"kind":"node","id":"symbol:write-lock","type":"Symbol","name":"write_lock","description":"Writes accepted unique evidence spans."}
{"kind":"node","id":"symbol:audit-evidence","type":"Symbol","name":"audit_evidence","description":"Compares current source with the lock without using SQLite."}
{"kind":"node","id":"symbol:build-database","type":"Symbol","name":"build_database","description":"Validates and atomically replaces the SQLite index."}
{"kind":"node","id":"symbol:connect-database","type":"Symbol","name":"connect_database","description":"Opens an existing graph index read-only."}
{"kind":"node","id":"symbol:resolve-node","type":"Symbol","name":"resolve_node","description":"Resolves IDs, aliases, or a unique partial match."}
{"kind":"node","id":"symbol:traverse","type":"Symbol","name":"traverse","description":"Performs bounded directed predicate-filtered graph traversal."}
{"kind":"node","id":"symbol:shortest-path","type":"Symbol","name":"shortest_path","description":"Finds a bounded breadth-first path."}
{"kind":"node","id":"symbol:evaluate-gold","type":"Symbol","name":"evaluate_gold","description":"Measures whether bounded retrieval reaches expected nodes."}
{"kind":"node","id":"symbol:mermaid","type":"Symbol","name":"mermaid","description":"Renders selected nodes and edges as Mermaid source."}
{"kind":"node","id":"symbol:execute","type":"Symbol","name":"execute","description":"Dispatches CLI commands and exit semantics."}
