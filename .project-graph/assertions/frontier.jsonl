{"kind":"node","id":"skill:crawl-project-graph","type":"Skill","name":"crawl-project-graph","description":"Coordinates deterministic file coverage, central reconciliation, review, and acceptance for large repositories."}
{"kind":"node","id":"skill:frontier-project-graph","type":"Skill","name":"frontier-project-graph","description":"Coordinates candidate-only architectural investigations and evidence-owning reconciliation."}
{"kind":"node","id":"flow:orchestrated-crawl","type":"Flow","name":"Orchestrated whole-repository crawl","description":"Assigns every eligible file a disposition, collects isolated candidate reports, and centrally reconciles reviewed assertions."}
{"kind":"node","id":"flow:frontier-reconciliation","type":"Flow","name":"Frontier-worker reconciliation","description":"Reopens evidence and adversarially reconciles distinct architectural investigations before promotion."}
{"kind":"node","id":"store:candidate-reports","type":"DataStore","name":"Raw candidate reports","description":"Disposable worker findings used for local audit and central reconciliation; they are not canonical graph truth."}
{"kind":"node","id":"invariant:candidate-isolation","type":"Invariant","name":"Candidate artifacts remain outside assertion globs","description":"Raw worker output is isolated from canonical assertion ingestion until the orchestrator explicitly promotes reviewed facts."}
{"kind":"node","id":"invariant:unresolved-frontier-disagreement","type":"Invariant","name":"Unresolved frontier disagreement is not asserted","description":"Conflicting or uncertain frontier findings remain a gap, decision candidate, or investigation rather than canonical graph fact."}
